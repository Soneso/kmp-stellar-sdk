                    "required": false,
                    "type": "string"
                },
                {
                    "name": "mobile_number_format",
                    "description": "Expected format of the `mobile_number` field. E.g.: `E.164`, `hash`, etc... In case this field is not specified, receiver should assume it's in `E.164` format",
