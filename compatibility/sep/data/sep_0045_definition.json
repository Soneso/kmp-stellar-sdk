        "sep": "0045",
        "title": "Stellar Web Authentication for Contract Accounts",
        "author": "Philip Liu <@philipliu>, Marcelo Salloum <@marcelosalloum>, Leigh McCulloch <@leighmcculloch>",
        "status": "Draft",
