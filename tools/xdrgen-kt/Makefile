# Makefile for KMP Stellar SDK XDR code generator.
#
# Orchestrates the full pipeline: gem setup, .x file download, Kotlin generation.
# Uses the existing download-xdr.sh and generate.rb scripts.
#
# Prerequisites:
#   - Ruby 3.x with Bundler
#   - curl (for downloading .x files)
#
# Usage:
#   make              # Show available targets
#   make generate     # Full pipeline: setup gems, download .x files, generate Kotlin
#   make clean        # Remove generated Kotlin files
#   make clean-all    # Remove generated Kotlin files and downloaded .x files

.DEFAULT_GOAL := help

# --- Paths -------------------------------------------------------------------

SCRIPT_DIR     := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
PROJECT_ROOT   := $(abspath $(SCRIPT_DIR)/../..)
XDR_DIR        := $(SCRIPT_DIR)xdr
DOWNLOAD_SCRIPT := $(SCRIPT_DIR)download-xdr.sh
GENERATE_SCRIPT := $(SCRIPT_DIR)generate.rb
GEMFILE         := $(SCRIPT_DIR)Gemfile
VENDOR_DIR      := $(SCRIPT_DIR)vendor
OUTPUT_DIR      := $(PROJECT_ROOT)/stellar-sdk/src/commonMain/kotlin/com/soneso/stellar/sdk/xdr

# Marker file written by download-xdr.sh to record the commit used
XDR_COMMIT_MARKER := $(XDR_DIR)/.commit

# Bundler uses a local vendor directory to avoid polluting system gems
BUNDLE_CONFIG := BUNDLE_GEMFILE=$(GEMFILE)
BUNDLE_CMD    := $(BUNDLE_CONFIG) bundle

# --- Sentinel files ----------------------------------------------------------
# Tracks whether gems have been installed. Re-runs bundle install only when
# Gemfile or Gemfile.lock changes.

GEMS_INSTALLED := $(VENDOR_DIR)/.make-gems-installed

# --- Targets -----------------------------------------------------------------

.PHONY: help generate update download clean clean-xdr clean-all setup test update-snapshots

help: ## Show available targets with descriptions
	@echo "KMP Stellar SDK XDR Generator"
	@echo ""
	@echo "Targets:"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-22s\033[0m %s\n", $$1, $$2}'
	@echo ""
	@echo "Typical workflow:"
	@echo "  make generate          Run the full pipeline"
	@echo "  make update            Re-download and regenerate after changing xdr-source.cfg"
	@echo "  make clean-all         Start fresh (remove all generated and downloaded files)"
	@echo ""
	@echo "To update to a new XDR spec version:"
	@echo "  1. Edit xdr-source.cfg and set XDR_COMMIT to the new commit hash"
	@echo "  2. Run: make update"

update: clean-all generate ## Re-download .x files and regenerate (use after changing xdr-source.cfg)

generate: setup download clean _run-generator ## Full pipeline: install gems, download .x files, generate Kotlin
	@echo ""
	@echo "Generation complete."
	@echo "Output: $(OUTPUT_DIR)"
	@GENERATED=$$(grep -rl 'Automatically generated by xdrgen' "$(OUTPUT_DIR)" 2>/dev/null | wc -l | tr -d ' '); \
		echo "Generated files: $$GENERATED"

download: ## Download .x files from stellar/stellar-xdr at the pinned commit
	@chmod +x "$(DOWNLOAD_SCRIPT)"
	@"$(DOWNLOAD_SCRIPT)"

clean: ## Remove generated Kotlin XDR files (preserves hand-maintained files)
	@if [ ! -d "$(OUTPUT_DIR)" ]; then \
		echo "Output directory does not exist: $(OUTPUT_DIR)"; \
		exit 0; \
	fi; \
	FOUND=$$(grep -rl 'Automatically generated by xdrgen' "$(OUTPUT_DIR)" 2>/dev/null || true); \
	if [ -z "$$FOUND" ]; then \
		echo "No generated files found in $(OUTPUT_DIR)"; \
	else \
		COUNT=$$(echo "$$FOUND" | wc -l | tr -d ' '); \
		echo "$$FOUND" | xargs rm -f; \
		echo "Removed $$COUNT generated file(s)."; \
	fi

clean-xdr: ## Remove downloaded .x files
	@"$(DOWNLOAD_SCRIPT)" --clean

clean-all: clean clean-xdr ## Remove generated Kotlin files and downloaded .x files
	@echo "All generated and downloaded files removed."

setup: $(GEMS_INSTALLED) ## Install Ruby gem dependencies via Bundler

test: setup ## Run snapshot tests against the Kotlin generator
	@cd "$(SCRIPT_DIR)" && $(BUNDLE_CMD) exec ruby test/generator_snapshot_test.rb

update-snapshots: setup ## Regenerate test snapshots from fixtures
	@cd "$(SCRIPT_DIR)" && $(BUNDLE_CMD) exec ruby test/update_snapshots.rb

# --- Internal targets --------------------------------------------------------

# Install gems only when Gemfile or Gemfile.lock changes
$(GEMS_INSTALLED): $(GEMFILE) $(GEMFILE).lock
	@echo "Installing Ruby gem dependencies..."
	@cd "$(SCRIPT_DIR)" && bundle config set --local path vendor/bundle
	@cd "$(SCRIPT_DIR)" && bundle install --quiet
	@mkdir -p "$(dir $(GEMS_INSTALLED))"
	@touch "$(GEMS_INSTALLED)"
	@echo "Gems installed."

# Run the generator. Requires .x files to be present.
_run-generator:
	@if [ ! -d "$(XDR_DIR)" ] || [ -z "$$(ls -A "$(XDR_DIR)"/*.x 2>/dev/null)" ]; then \
		echo "ERROR: No .x files found in $(XDR_DIR)."; \
		echo "Run 'make download' first."; \
		exit 1; \
	fi
	@echo ""
	@echo "Generating Kotlin XDR types..."
	@cd "$(SCRIPT_DIR)" && $(BUNDLE_CMD) exec ruby "$(GENERATE_SCRIPT)"
